/**
 * PawMeBot Community — Environment Configuration
 * 
 * Copy this to .env.local and fill in your values:
 * cp .env.example .env.local
 */

// =============================================================================
// FIREBASE (Required for real-time data, auth, storage)
// =============================================================================

// Option 1: Service Account JSON (recommended for server-side)
// Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","client_id":"YOUR_CLIENT_ID"}

// Option 2: Application Default Credentials (for GCP environments)
// GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

// Firebase Web Config (for client-side auth, if needed)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

// =============================================================================
// TELEGRAM (For posting notifications and admin alerts)
// =============================================================================

// Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=8667239116:AAGp0Gs7Xvc1brLev6JBkcEQxcHpylw1FV8

// Your channel/group ID (use @userinfobot to find your chat ID)
// For a channel, use the channel username with @ prefix (e.g., @pawme_community)
// For a group, use the negative group ID (e.g., -1001234567890)
TELEGRAM_CHANNEL_ID=your_telegram_channel_id

// =============================================================================
// X / TWITTER (For auto-posting to X)
// =============================================================================

// Get from: developer.x.com → Your App → Keys and Tokens
X_API_KEY=your_consumer_key
X_API_SECRET=your_consumer_secret
X_ACCESS_TOKEN=your_access_token
X_TOKEN_SECRET=your_token_secret

// =============================================================================
// GEMINI AI (For AI-powered content generation)
// =============================================================================

// Get from: aistudio.google.com → API Keys
GEMINI_API_KEY=your_gemini_api_key

// Optional: Override model selection
// GEMINI_TEXT_MODELS=gemini-2.5-flash,gemini-2.5-pro
// GEMINI_VISION_MODELS=gemini-2.5-flash,gemini-2.5-pro

// =============================================================================
// VERCEL CRON (For automated posting schedule)
// =============================================================================

// Generate with: openssl rand -hex 16
CRON_SECRET=your_cron_secret_here

// =============================================================================
// OPTIONAL: Additional services
// =============================================================================

// For Reddit posting (if implementing Reddit API)
// REDDIT_CLIENT_ID=your_reddit_client_id
// REDDIT_CLIENT_SECRET=your_reddit_client_secret
// REDDIT_USERNAME=your_reddit_username
// REDDIT_PASSWORD=your_reddit_password

// For webhooks (e.g., Discord notifications)
// DISCORD_WEBHOOK_URL=your_discord_webhook_url
